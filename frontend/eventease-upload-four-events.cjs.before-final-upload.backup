async function main() {
  if (!dryRun && process.env.FIRESTORE_EMULATOR_HOST) {
    throw new Error("Live upload blocked while emulator is configured.");
  }

  if (!dryRun) {
    if (!admin.apps.length) {
      admin.initializeApp({
        credential: admin.credential.applicationDefault(),
        projectId
      });
    }

    const db = admin.firestore();

    // Check all IDs before writing anything.
    const refs = events.map((event) =>
      db.collection("events").doc(event.id)
    );

    const snapshots = await db.getAll(...refs);

    const existing = snapshots
      .filter((snapshot) => snapshot.exists)
      .map((snapshot) => snapshot.id);

    if (existing.length > 0) {
      throw new Error(
        "Upload stopped. These IDs already exist: " +
        existing.join(", ")
      );
    }

    // Create-only writes prevent overwriting existing events.
    const batch = db.batch();

    for (const event of events) {
      const { id, ...details } = event;

      batch.create(db.collection("events").doc(id), {
        ...details,
        bookedCount: 0,
        status: "published",
        createdAt: admin.firestore.FieldValue.serverTimestamp()
      });
    }

    await batch.commit();

    console.log("SUCCESS: Uploaded 4 events.");
  } else {
    console.log("PREVIEW MODE — NO FIRESTORE WRITES");
    console.table(
      events.map((event) => ({
        id: event.id,
        title: event.title,
        category: event.category,
        date: event.date,
        seats: event.seats
      }))
    );
  }
}

main().catch((error) => {
  console.error(error);
  process.exitCode = 1;
});