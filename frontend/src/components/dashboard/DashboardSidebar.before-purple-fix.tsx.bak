"use client";

import Link from "next/link";
import { usePathname } from "next/navigation";
import { signOut } from "firebase/auth";
import { auth } from "@/lib/firebase";

type Role = "admin" | "student";

const studentLinks = [
  { label: "Dashboard", href: "/", icon: "⌂" },
  { label: "Explore Events", href: "/explore-events", icon: "◈" },
  { label: "My Bookings", href: "/my-bookings", icon: "▣" },
];

const adminLinks = [
  { label: "Dashboard", href: "/admin", icon: "⌂" },
  { label: "Add Event", href: "/admin/add-event", icon: "+" },
  { label: "Manage Categories", href: "/admin/categories", icon: "▦" },
];

export default function DashboardSidebar({
  role,
}: {
  role: Role;
}) {
  const pathname = usePathname();
  const links = role === "admin" ? adminLinks : studentLinks;

  return (
    <aside className="w-full shrink-0 border-b border-slate-200 bg-white lg:min-h-screen lg:w-64 lg:border-b-0 lg:border-r">
      <div className="flex items-center gap-3 border-b border-slate-100 px-5 py-6">
        <div className="flex h-11 w-11 items-center justify-center rounded-2xl bg-indigo-600 text-xl font-bold text-white">
          E
        </div>

        <div>
          <div className="text-lg font-bold text-slate-900">
            Event Ease
          </div>
          <div className="text-xs font-medium text-slate-500">
            {role === "admin" ? "Admin Workspace" : "Student Portal"}
          </div>
        </div>
      </div>

      <div className="px-4 py-5">
        <div className="mb-3 px-3 text-xs font-semibold uppercase tracking-widest text-slate-400">
          Navigation
        </div>

        <nav aria-label={`${role} navigation`} className="flex flex-wrap gap-2 lg:flex-col">
          {links.map((link) => {
            const active = pathname === link.href;

            return (
              <Link
                key={link.href}
                href={link.href}
                aria-current={active ? "page" : undefined}
                className={`flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-semibold transition ${
                  active
                    ? "bg-indigo-600 text-white shadow-sm"
                    : "text-slate-600 hover:bg-indigo-50 hover:text-indigo-700"
                }`}
              >
                <span className="w-5 text-center text-lg">
                  {link.icon}
                </span>
                {link.label}
              </Link>
            );
          })}
        </nav>
      </div>

      <div className="px-4 pb-6 lg:mt-12">
        <div className="rounded-2xl bg-slate-50 p-4">
          <p className="text-sm font-semibold text-slate-800">
            {role === "admin" ? "Manage your campus" : "Make the most of campus life"}
          </p>
          <p className="mt-1 text-xs leading-5 text-slate-500">
            {role === "admin"
              ? "Manage events, registrations, and categories."
              : "Discover events and keep track of your bookings."}
          </p>

          <button
            type="button"
            onClick={async () => {
              try {
                await signOut(auth);
                window.location.assign("/");
              } catch (error) {
                console.error("Sign out failed:", error);
              }
            }}
            className="mt-4 w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-100"
          >
            Sign out
          </button>
        </div>
      </div>
    </aside>
  );
}