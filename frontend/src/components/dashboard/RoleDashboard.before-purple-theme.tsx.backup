"use client";

import Link from "next/link";
import { useRouter } from "next/navigation";
import { useEffect, useState } from "react";
import { onAuthStateChanged, type User } from "firebase/auth";
import {
  collection,
  onSnapshot,
  query,
  where,
  type DocumentData,
  type Query,
  type Unsubscribe,
} from "firebase/firestore";
import { auth, db } from "@/lib/firebase";
import DashboardSidebar from "./DashboardSidebar";

type Role = "admin" | "student";

type EventItem = {
  id: string;
  title: string;
  date: string;
  time: string;
  location: string;
  category: string;
  status: string;
  seats: number;
  bookedCount: number;
};

type BookingItem = {
  id: string;
  eventId: string;
  userId: string;
};

type Stat = {
  label: string;
  value: number;
  icon: string;
  accent: string;
};

function toEvent(id: string, data: DocumentData): EventItem {
  return {
    id,
    title: String(data.title ?? "Untitled event"),
    date: String(data.date ?? ""),
    time: String(data.time ?? ""),
    location: String(data.location ?? ""),
    category: String(data.category ?? "General"),
    status: String(data.status ?? ""),
    seats: Number(data.seats ?? 0),
    bookedCount: Number(data.bookedCount ?? 0),
  };
}

function MetricCard({ stat }: { stat: Stat }) {
  return (
    <div className="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <div className="flex items-center justify-between">
        <span className="text-sm font-medium text-slate-500">
          {stat.label}
        </span>
        <span className={`rounded-xl px-3 py-2 text-xl ${stat.accent}`}>
          {stat.icon}
        </span>
      </div>

      <div className="mt-5 text-3xl font-bold tracking-tight text-slate-900">
        {stat.value.toLocaleString()}
      </div>

      <p className="mt-1 text-xs text-slate-400">
        From your Firebase database
      </p>
    </div>
  );
}

function ActionCard({
  title,
  description,
  href,
  icon,
}: {
  title: string;
  description: string;
  href: string;
  icon: string;
}) {
  return (
    <Link
      href={href}
      className="group flex items-center gap-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-indigo-300 hover:shadow-md"
    >
      <span className="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-indigo-50 text-2xl text-indigo-700">
        {icon}
      </span>

      <span className="min-w-0 flex-1">
        <span className="block font-semibold text-slate-900 group-hover:text-indigo-700">
          {title}
        </span>
        <span className="mt-1 block text-sm text-slate-500">
          {description}
        </span>
      </span>

      <span className="text-xl text-slate-400">→</span>
    </Link>
  );
}

export default function RoleDashboard({
  role,
}: {
  role: Role;
}) {
  const router = useRouter();

  const [user, setUser] = useState<User | null>(null);
  const [verified, setVerified] = useState(false);
  const [authError, setAuthError] = useState("");

  const [events, setEvents] = useState<EventItem[]>([]);
  const [bookings, setBookings] = useState<BookingItem[]>([]);
  const [studentCount, setStudentCount] = useState(0);
  const [categoryCount, setCategoryCount] = useState(0);

  const [eventsReady, setEventsReady] = useState(false);
  const [bookingsReady, setBookingsReady] = useState(false);
  const [usersReady, setUsersReady] = useState(false);
  const [categoriesReady, setCategoriesReady] = useState(false);

  const [dataErrors, setDataErrors] = useState<string[]>([]);

  useEffect(() => {
    let active = true;

    const unsubscribe = onAuthStateChanged(
      auth,
      async (currentUser) => {
        setVerified(false);
        setUser(null);
        setAuthError("");

        if (!currentUser) {
          router.replace("/login");
          return;
        }

        try {
          // Refresh the token so the role check uses current claims.
          const token = await currentUser.getIdTokenResult(true);

          if (!active) return;

          const isAdmin = token.claims.admin === true;

          if (role === "admin" && !isAdmin) {
            router.replace("/");
            return;
          }

          if (role === "student" && isAdmin) {
            router.replace("/admin");
            return;
          }

          setUser(currentUser);
          setVerified(true);
        } catch (error) {
          if (!active) return;

          setAuthError(
            error instanceof Error
              ? error.message
              : "Unable to verify your account."
          );
        }
      },
      (error) => {
        if (active) setAuthError(error.message);
      }
    );

    return () => {
      active = false;
      unsubscribe();
    };
  }, [role, router]);

  useEffect(() => {
    if (!verified || !user) return;

    let active = true;
    const unsubscribers: Unsubscribe[] = [];

    const reportError = (name: string, error: Error) => {
      if (!active) return;

      console.error(`${name} dashboard listener failed:`, error);

      setDataErrors((previous) => [
        ...previous.filter((item) => !item.startsWith(`${name}:`)),
        `${name}: ${error.message}`,
      ]);
    };

    const watch = (
      name: string,
      source: Query<DocumentData>,
      onData: (docs: Array<{ id: string; data: DocumentData }>) => void,
      onReady: () => void
    ) => {
      const unsubscribe = onSnapshot(
        source,
        (snapshot) => {
          if (!active) return;

          onData(
            snapshot.docs.map((item) => ({
              id: item.id,
              data: item.data(),
            }))
          );

          onReady();
        },
        (error) => {
          reportError(name, error);
          onReady();
        }
      );

      unsubscribers.push(unsubscribe);
    };

    setDataErrors([]);
    setEventsReady(false);
    setBookingsReady(false);
    setUsersReady(role !== "admin");
    setCategoriesReady(role !== "admin");

    const eventsQuery =
      role === "admin"
        ? query(collection(db, "events"))
        : query(
            collection(db, "events"),
            where("status", "==", "published")
          );

    watch(
      "Events",
      eventsQuery,
      (docs) => {
        setEvents(docs.map((item) => toEvent(item.id, item.data)));
      },
      () => setEventsReady(true)
    );

    const bookingsQuery =
      role === "admin"
        ? query(collection(db, "bookings"))
        : query(
            collection(db, "bookings"),
            where("userId", "==", user.uid)
          );

    watch(
      "Bookings",
      bookingsQuery,
      (docs) => {
        setBookings(
          docs.map((item) => ({
            id: item.id,
            eventId: String(item.data.eventId ?? ""),
            userId: String(item.data.userId ?? ""),
          }))
        );
      },
      () => setBookingsReady(true)
    );

    if (role === "admin") {
      watch(
        "Users",
        query(collection(db, "users")),
        (docs) => {
          setStudentCount(
            docs.filter((item) => item.data.role === "student").length
          );
        },
        () => setUsersReady(true)
      );

      watch(
        "Categories",
        query(collection(db, "categories")),
        (docs) => {
          setCategoryCount(
            docs.filter((item) => item.data.active === true).length
          );
        },
        () => setCategoriesReady(true)
      );
    }

    return () => {
      active = false;
      unsubscribers.forEach((unsubscribe) => unsubscribe());
    };
  }, [role, verified, user]);

  const loading =
    !eventsReady ||
    !bookingsReady ||
    !usersReady ||
    !categoriesReady;

  const today = new Date();
  const todayString = [
    today.getFullYear(),
    String(today.getMonth() + 1).padStart(2, "0"),
    String(today.getDate()).padStart(2, "0"),
  ].join("-");

  const upcomingEvents = events
    .filter(
      (event) =>
        event.status === "published" &&
        event.date >= todayString
    )
    .sort(
      (a, b) =>
        `${a.date} ${a.time}`.localeCompare(
          `${b.date} ${b.time}`
        )
    );

  const bookedEventIds = new Set(
    bookings.map((booking) => booking.eventId)
  );

  const studentUpcoming = upcomingEvents.filter((event) =>
    bookedEventIds.has(event.id)
  );

  const stats: Stat[] =
    role === "admin"
      ? [
          {
            label: "Total Events",
            value: events.filter((event) => event.title !== "Untitled event").length,
            icon: "▦",
            accent: "bg-indigo-50 text-indigo-700",
          },
          {
            label: "Total Bookings",
            value: bookings.length,
            icon: "▣",
            accent: "bg-emerald-50 text-emerald-700",
          },
          {
            label: "Registered Students",
            value: studentCount,
            icon: "♙",
            accent: "bg-sky-50 text-sky-700",
          },
          {
            label: "Active Categories",
            value: categoryCount,
            icon: "◈",
            accent: "bg-amber-50 text-amber-700",
          },
        ]
      : [
          {
            label: "Available Events",
            value: events.length,
            icon: "▦",
            accent: "bg-indigo-50 text-indigo-700",
          },
          {
            label: "My Bookings",
            value: bookings.length,
            icon: "▣",
            accent: "bg-emerald-50 text-emerald-700",
          },
          {
            label: "My Upcoming Events",
            value: studentUpcoming.length,
            icon: "◷",
            accent: "bg-sky-50 text-sky-700",
          },
          {
            label: "Upcoming Campus Events",
            value: upcomingEvents.length,
            icon: "✦",
            accent: "bg-amber-50 text-amber-700",
          },
        ];

  const visibleEvents =
    role === "admin"
      ? [...events]
          .filter((event) => event.title !== "Untitled event")
          .sort((a, b) => b.date.localeCompare(a.date))
          .slice(0, 5)
      : upcomingEvents.slice(0, 5);

  if (authError) {
    return (
      <main className="flex min-h-screen items-center justify-center bg-slate-50 p-6">
        <div className="max-w-lg rounded-2xl border border-red-200 bg-white p-8">
          <h1 className="text-xl font-bold text-slate-900">
            Authentication error
          </h1>
          <p className="mt-3 break-words text-sm text-red-700">
            {authError}
          </p>
          <button
            onClick={() => window.location.reload()}
            className="mt-5 rounded-xl bg-indigo-600 px-4 py-2 text-white"
          >
            Retry
          </button>
        </div>
      </main>
    );
  }

  if (!verified || !user) {
    return (
      <main className="flex min-h-screen items-center justify-center bg-slate-50">
        <p className="text-sm font-medium text-slate-500">
          Verifying your account...
        </p>
      </main>
    );
  }

  return (
    <div className="min-h-screen bg-slate-50 text-slate-900 lg:flex">
      <DashboardSidebar role={role} />

      <main className="min-w-0 flex-1 px-4 py-7 sm:px-8 lg:px-10 lg:py-10">
        <div className="mx-auto max-w-7xl">
          <header className="mb-8 flex flex-wrap items-center justify-between gap-4">
            <div>
              <div className="mb-2 text-xs font-bold uppercase tracking-widest text-indigo-600">
                {role === "admin" ? "Administration" : "Student Portal"}
              </div>

              <h1 className="text-3xl font-bold tracking-tight sm:text-4xl">
                {role === "admin"
                  ? "Admin Dashboard"
                  : "Student Dashboard"}
              </h1>

              <p className="mt-2 text-sm text-slate-500">
                {role === "admin"
                  ? "Manage campus events and monitor registrations."
                  : "Discover campus events and manage your participation."}
              </p>
            </div>

            <div className="rounded-2xl border border-slate-200 bg-white px-4 py-3 shadow-sm">
              <div className="text-xs text-slate-400">
                Signed in as
              </div>
              <div className="max-w-56 truncate text-sm font-semibold text-slate-800">
                {user.email ?? "Firebase user"}
              </div>
            </div>
          </header>

          {dataErrors.length > 0 && (
            <section
              role="alert"
              className="mb-6 rounded-2xl border border-red-200 bg-red-50 p-4"
            >
              <h2 className="font-semibold text-red-800">
                Some dashboard data could not be loaded
              </h2>
              {dataErrors.map((message) => (
                <p
                  key={message}
                  className="mt-2 break-words text-sm text-red-700"
                >
                  {message}
                </p>
              ))}
            </section>
          )}

          {loading ? (
            <div className="rounded-2xl border border-slate-200 bg-white p-8 text-center text-slate-500">
              Loading live dashboard data...
            </div>
          ) : (
            <>
              <section
                aria-label="Dashboard statistics"
                className="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4"
              >
                {stats.map((stat) => (
                  <MetricCard key={stat.label} stat={stat} />
                ))}
              </section>

              <section className="mt-9">
                <div className="mb-4">
                  <h2 className="text-xl font-bold text-slate-900">
                    Quick Actions
                  </h2>
                  <p className="mt-1 text-sm text-slate-500">
                    {role === "admin"
                      ? "Your event management tools."
                      : "Everything you need to get involved."}
                  </p>
                </div>

                <div className="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
                  {role === "admin" ? (
                    <>
                      <ActionCard
                        title="Create Event"
                        description="Publish a new campus event"
                        href="/admin/add-event"
                        icon="+"
                      />
                      <ActionCard
                        title="Manage Categories"
                        description="Organize event categories"
                        href="/admin/categories"
                        icon="◈"
                      />
                      <ActionCard
                        title="View Events"
                        description="Review published campus events"
                        href="/explore-events"
                        icon="▦"
                      />
                    </>
                  ) : (
                    <>
                      <ActionCard
                        title="Explore Events"
                        description="Find your next campus activity"
                        href="/explore-events"
                        icon="⌕"
                      />
                      <ActionCard
                        title="My Bookings"
                        description="View your registrations"
                        href="/my-bookings"
                        icon="▣"
                      />
                    </>
                  )}
                </div>
              </section>

              <section className="mt-9 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
                <div className="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 p-5">
                  <div>
                    <h2 className="text-xl font-bold">
                      {role === "admin"
                        ? "Recent Events"
                        : "Upcoming Events"}
                    </h2>
                    <p className="mt-1 text-sm text-slate-500">
                      {role === "admin"
                        ? "Events currently stored in Firestore."
                        : "Real published events you can explore."}
                    </p>
                  </div>

                  <Link
                    href="/explore-events"
                    className="text-sm font-semibold text-indigo-600 hover:underline"
                  >
                    Explore Events →
                  </Link>
                </div>

                {visibleEvents.length === 0 ? (
                  <div className="px-6 py-12 text-center">
                    <div className="text-3xl">▦</div>
                    <h3 className="mt-3 font-semibold text-slate-800">
                      No events to display
                    </h3>
                    <p className="mt-2 text-sm text-slate-500">
                      {role === "admin"
                        ? "Create an event to populate this dashboard."
                        : "Published upcoming events will appear here."}
                    </p>
                  </div>
                ) : (
                  <div className="divide-y divide-slate-100">
                    {visibleEvents.map((event) => (
                      <div
                        key={event.id}
                        className="flex flex-wrap items-center justify-between gap-4 px-5 py-4"
                      >
                        <div className="min-w-0">
                          <h3 className="font-semibold text-slate-900">
                            {event.title}
                          </h3>
                          <p className="mt-1 text-sm text-slate-500">
                            {event.date || "Date not set"}
                            {event.time ? ` · ${event.time}` : ""}
                            {event.location ? ` · ${event.location}` : ""}
                          </p>
                          <p className="mt-1 text-xs text-slate-400">
                            {event.category}
                            {role === "admin"
                              ? ` · ${event.bookedCount}/${event.seats} booked`
                              : ""}
                          </p>
                        </div>

                        <Link
                          href={`/events/${encodeURIComponent(event.id)}`}
                          className="rounded-xl bg-indigo-50 px-4 py-2 text-sm font-semibold text-indigo-700 hover:bg-indigo-100"
                        >
                          View Event
                        </Link>
                      </div>
                    ))}
                  </div>
                )}
              </section>

              {role === "student" && (
                <section className="mt-8 rounded-2xl bg-indigo-600 p-6 text-white sm:p-8">
                  <h2 className="text-xl font-bold">
                    Your next campus experience starts here
                  </h2>
                  <p className="mt-2 max-w-xl text-sm text-indigo-100">
                    Explore available events, register for activities,
                    and keep your bookings organized.
                  </p>
                  <Link
                    href="/explore-events"
                    className="mt-5 inline-block rounded-xl bg-white px-5 py-3 text-sm font-bold text-indigo-700"
                  >
                    Explore Events →
                  </Link>
                </section>
              )}
            </>
          )}
        </div>
      </main>
    </div>
  );
}